{
  "name": "liveid-takatak",
  "version": "1.0.0",
  "private": true,
  "description": "TAKATAK LIVE ID: phone, email, live face + voice check, and ID front face match. OAuth-style identity verification for takatak.ca and partner restaurants.",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "node scripts/build-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/cli/migrate.ts",
    "client:create": "tsx src/cli/create-client.ts",
    "keys:generate": "tsx src/cli/generate-keys.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:models": "vitest run test/models",
    "test:e2e": "node scripts/e2e-browser.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/formbody": "9.0.1",
    "@fastify/multipart": "10.1.6",
    "@fastify/static": "10.1.8",
    "@tensorflow/tfjs-node": "4.22.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@vladmandic/face-api": "1.7.15",
    "@vladmandic/human": "3.3.6",
    "fastify": "5.12.7",
    "jose": "6.2.14",
    "libphonenumber-js": "1.13.15",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
