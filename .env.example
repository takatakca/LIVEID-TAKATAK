# TAKATAK LIVE ID — copy to .env for local work. In Coolify, put each value in the app's secrets.
# Never commit real values. Generate fresh secrets with: npm run keys:generate

NODE_ENV=development
PORT=8080
PUBLIC_URL=http://localhost:8080
# Behind Coolify/Traefik:
TRUST_PROXY=false

DATABASE_URL=postgres://liveid:liveid@127.0.0.1:5432/liveid
DATABASE_SSL=false

# From `npm run keys:generate` (secret pepper, AES-256 key, Ed25519 signing key as JWK JSON)
LIVEID_SECRET=
LIVEID_ENCRYPTION_KEY=
LIVEID_SIGNING_KEY=

# SMS: console (dev only) or twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_LOOKUP_LINE_TYPE=false
ALLOWED_PHONE_COUNTRIES=CA,US

# Email: console (dev only) or smtp
EMAIL_PROVIDER=console
SMTP_URL=
EMAIL_FROM=TAKATAK LIVE ID <no-reply@takatak.ca>

# Spoken digits: pocketsphinx (offline, in the Docker image) or openai
SPEECH_PROVIDER=pocketsphinx
POCKETSPHINX_PYTHON=python3
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Development only
DEV_OUTBOX=false
BLOCK_AUTOMATION=true

SESSION_TTL_MINUTES=30
RETENTION_DAYS=30
